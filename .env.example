# App Configuration
APP_NAME="ContextIQ — Enterprise Semantic Context Engine"
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=esce_db
POSTGRES_USER=esce_user
POSTGRES_PASSWORD=esce_password
DATABASE_URL=postgresql://esce_user:esce_password@localhost:5432/esce_db

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=esce_neo4j_password

# Gemini LLM Configuration (Set your fresh key from Google AI Studio here)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Embeddings & ChromaDB
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=enterprise_docs

# API Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]
